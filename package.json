{
  "name": "ocd",
  "version": "0.0.0",
  "private": true,
  "description": "A local agent control plane with an OpenCode manager and durable supervision.",
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test",
    "db:generate": "vp run --filter @ocd/supervisor db:generate"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "warn"
    }
  }
}
