{
  "compilerOptions": {
    "target": "es2023",
    "module": "NodeNext",
    "lib": ["ES2023"],
    /* OpenCode TUI plugin (packages/plugin/tui.tsx): Solid JSX on OpenTUI, compiled by the OpenCode host */
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "types": ["node"],
    "skipLibCheck": true,

    /* Node.js ESM; workspace packages resolve to source via the "source" condition */
    "moduleResolution": "NodeNext",
    "customConditions": ["source"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "packages/*/src",
    "packages/plugin/tui.tsx",
    "packages/*/scripts",
    "packages/*/vite.config.ts",
    "packages/*/drizzle.config.ts",
    "vite.config.ts"
  ]
}
